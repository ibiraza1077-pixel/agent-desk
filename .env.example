# Agent Desk configuration. Copy to .env and edit. Never commit .env.
# Every value below is optional; defaults are shown.

# demo  = simulated market, no Alpaca account needed (default)
# paper = Alpaca PAPER trading (free account). Live trading is deliberately unsupported.
DESK_MODE=demo

# Demo mode only: "scripted" = rule-based agents, fully offline; "llm" = real AI agents (LLM_PROVIDER below)
DEMO_AGENTS=scripted

# --- Alpaca paper keys (free; required in paper mode) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Which AI runs the agents ---
# claude_code   = RECOMMENDED. Claude (Opus 5.5) through the Claude Code CLI, using your Claude Pro/Max login.
#                 No API key or per-token bill; calls count against your plan's usage limits (the dashboard
#                 shows calls today). On a usage-limit reply the agents pause for CLAUDE_CODE_COOLDOWN_MINUTES.
#                 Any ANTHROPIC_API_KEY is deliberately hidden from the CLI so it can never bill the API.
# ollama        = FREE, local model on this computer via the Ollama app (no key; data stays local)
# openai_compat = any OpenAI-compatible API, e.g. free tiers of Groq, Google Gemini, OpenRouter
# anthropic     = Claude API with an API key (pay per token, billed separately from Claude plans)
# Left empty: anthropic if ANTHROPIC_API_KEY is set, else claude_code if the `claude` CLI is installed, else ollama.
LLM_PROVIDER=claude_code
CLAUDE_CODE_CLI=claude            # path to the Claude Code CLI if it isn't on PATH
CLAUDE_CODE_COOLDOWN_MINUTES=30
OLLAMA_URL=http://127.0.0.1:11434

# openai_compat only. Examples (sign up for a free key, then pick a model from their model list):
#   Groq:       https://api.groq.com/openai/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter: https://openrouter.ai/api/v1   (models whose id ends in ":free")
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=      # optional for local servers (LM Studio, llama.cpp)
# $ per 1M tokens. Leave 0 for free tiers. Set them for a PAID endpoint so DAILY_LLM_BUDGET_USD applies.
OPENAI_COMPAT_PRICE_IN=0
OPENAI_COMPAT_PRICE_OUT=0

# anthropic only
ANTHROPIC_API_KEY=

# US stocks/ETFs only (symbols containing "/" such as crypto pairs are rejected)
WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,JPM,XOM

# Cycle timing
CYCLE_MINUTES=15          # paper mode
DEMO_CYCLE_SECONDS=20     # demo mode
MAX_CANDIDATES_PER_CYCLE=3
DEMO_SEED=42

# Risk limits (enforced by code the AI cannot override)
MAX_POSITION_PCT=0.10
MAX_OPEN_POSITIONS=5
MAX_GROSS_EXPOSURE_PCT=0.60
DAILY_LOSS_LIMIT_PCT=0.02
MIN_CONFIDENCE=0.6
MAX_STOP_DISTANCE_PCT=0.08
MIN_REWARD_RISK=1.5

# Models. Leave empty for the provider default (ollama: qwen3.5:9b, anthropic: claude-opus-5-5).
# Ollama: any model you've pulled, e.g. gemma4:12b (slower, sometimes better reasoning).
MODEL_CHIEF=
MODEL_ANALYSTS=
EFFORT_CHIEF=medium       # claude_code / anthropic: low | medium | high | xhigh | max
EFFORT_ANALYSTS=low
DAILY_LLM_BUDGET_USD=10   # applies to Claude and priced openai_compat; free providers are never capped

# Optional
# DESK_DB=desk.db          # defaults: desk-demo.db (demo, reset on every start), desk.db (paper)
# DESK_AUTOSTART=1         # set 0 to serve the dashboard without the scheduler

# Phone access on your home Wi-Fi, behind a secret key (printed as a link when the desk starts). Off = this Mac only.
DESK_PHONE_ACCESS=0
# DESK_ACCESS_KEY=   # optional: set your own key instead of the generated one in data/.desk_access_key
# VIX window: SPY buys only when the latest VIX close >= this (study edge is above 30). 0 disables the rule.
INDEX_BUY_MIN_VIX=30
